# Multi-Provider LLM Platform Configuration
# Copy this file to .env and configure the appropriate API keys for your deployment.

# Active LLM Provider Selection
# Options: auto | openai | anthropic | gemini | groq | ollama | fallback
LLM_PROVIDER=auto
MODEL_ROUTER_MODE=auto

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq Configuration (Ultra-Fast Inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Configuration (Local / Private Offline Inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Database Configuration (PostgreSQL with pgvector or SQLite fallback)
POSTGRES_USER=lenny_user
POSTGRES_PASSWORD=lenny_secure_password_2026
POSTGRES_DB=lenny_growth_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=

# Application & CORS Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
