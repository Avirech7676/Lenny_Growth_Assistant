# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=lenny_user
POSTGRES_PASSWORD=lenny_secure_password_2026
POSTGRES_DB=lenny_growth_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lenny_user:lenny_secure_password_2026@db:5432/lenny_growth_db

# Local Ollama Configuration (Default Local Demo Engine)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Active LLM Provider Selection: "ollama" | "anthropic" | "openai"
LLM_PROVIDER=ollama

# Cloud Model API Keys (Optional - Local demo runs 100% on Ollama without keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Application Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Epistemic Grounding Calibration
COSINE_SIMILARITY_THRESHOLD=0.65
TOP_K_CHUNKS=4
